cmake_minimum_required(VERSION 2.8)
project(middle C)
execute_process(COMMAND python3 "${CMAKE_CURRENT_SOURCE_DIR}/identity.py" "${CMAKE_COMMAND}" "${CMAKE_ROOT}" "${CMAKE_VERSION}" "${CMAKE_BINARY_DIR}/middle-identity.json" RESULT_VARIABLE identity_status)
if(NOT identity_status EQUAL 0)
  message(FATAL_ERROR "native middle identity capture failed")
endif()
include(ExternalProject)
ExternalProject_Add(leaf URL "@ORIGIN@/leaf.tar.gz" URL_HASH SHA256=@LEAF_SHA@ CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX})
add_library(middle STATIC middle.c)
add_dependencies(middle leaf)
install(TARGETS middle ARCHIVE DESTINATION lib)
install(FILES "${CMAKE_BINARY_DIR}/middle-identity.json" DESTINATION share/legacy-proof)
