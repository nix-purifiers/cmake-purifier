cmake_minimum_required(VERSION 2.8)
project(legacy_native C)
execute_process(COMMAND python3 "${CMAKE_CURRENT_SOURCE_DIR}/identity.py" "${CMAKE_COMMAND}" "${CMAKE_ROOT}" "${CMAKE_VERSION}" "${CMAKE_BINARY_DIR}/root-identity.json" RESULT_VARIABLE identity_status)
if(NOT identity_status EQUAL 0)
  message(FATAL_ERROR "native root identity capture failed")
endif()
include(ExternalProject)
ExternalProject_Add(middle URL "@ORIGIN@/middle.tar.gz" URL_HASH SHA256=@MIDDLE_SHA@ CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>)
ExternalProject_Get_Property(middle INSTALL_DIR)
add_executable(assert_answer main.c)
add_dependencies(assert_answer middle)
target_link_libraries(assert_answer "${INSTALL_DIR}/lib/libmiddle.a" "${INSTALL_DIR}/lib/libleaf.a")
enable_testing()
add_test(answer assert_answer)
install(TARGETS assert_answer RUNTIME DESTINATION bin)
install(FILES "${INSTALL_DIR}/lib/libmiddle.a" "${INSTALL_DIR}/lib/libleaf.a" DESTINATION lib)
install(FILES "${CMAKE_BINARY_DIR}/root-identity.json" "${INSTALL_DIR}/share/legacy-proof/middle-identity.json" "${INSTALL_DIR}/share/legacy-proof/leaf-identity.json" DESTINATION share/legacy-proof)
export_library_dependencies("${CMAKE_BINARY_DIR}/legacy-dependencies.cmake")
if(NOT DEFINED EDGE_NEWLINE)
  set(EDGE_NEWLINE "line1\nline2")
endif()
foreach(kind SEMICOLON EMPTY SPACE NEWLINE DOLLAR ESCAPE)
  file(WRITE "${CMAKE_BINARY_DIR}/argument-${kind}.txt" "${EDGE_${kind}}")
  install(FILES "${CMAKE_BINARY_DIR}/argument-${kind}.txt" DESTINATION share/legacy-proof)
endforeach()
